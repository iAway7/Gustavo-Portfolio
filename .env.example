# Resend (contact form email delivery)
RESEND_API_KEY=your_resend_api_key
CONTACT_TO_EMAIL=your_inbox@example.com
# Sender for both contact emails. Defaults to this value when unset.
CONTACT_FROM_EMAIL="Gustavo Polin <contacto@emmvi.com>"

# Cloudflare Turnstile (recommended for contact form protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
